# Backend
APP_ENV=development
DATABASE_URL=sqlite:///./feature_intelligence.db
CORS_ORIGINS=http://localhost:5173

# AI Feature Triage (SPEC-003)
AI_ENABLED=true
AI_PRIMARY_PROVIDER=openai
AI_FALLBACK_PROVIDER=gemini
AI_REQUEST_TIMEOUT_SECONDS=30

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Semantic relationships (SPEC-004)
SEMANTIC_TOP_K=5
SEMANTIC_MIN_CANDIDATE_SCORE=0.50
SEMANTIC_STRONG_CANDIDATE_SCORE=0.75

# Frontend (Vite — prefix required for client exposure)
VITE_API_BASE_URL=http://localhost:8000
